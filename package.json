{
  "name": "trace",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "check": "npm run lint && npm run test && npm run build && npm run server:prepare-web && npm run cargo:test && npm run cargo:clippy",
    "lint": "eslint .",
    "preview": "vite preview",
    "e2e": "playwright test",
    "tauri": "tauri",
    "desktop:build:linux": "tauri build --ci --verbose --bundles deb appimage",
    "server:prepare-web": "node scripts/prepare-server-web.mjs",
    "server:dev": "npm run build && npm run server:prepare-web && cargo run -p trace-server --",
    "server:build": "npm run build && npm run server:prepare-web && cargo build --release -p trace-server",
    "cargo:clippy": "cargo clippy --workspace --all-targets -- -D warnings",
    "cargo:test": "cargo test --workspace",
    "test": "vitest run",
    "tauri:clippy": "cargo clippy --manifest-path src-tauri/Cargo.toml --all-targets -- -D warnings",
    "tauri:test": "cargo test --manifest-path src-tauri/Cargo.toml"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@fontsource/space-grotesk": "^5.2.10",
    "@mantine/core": "^8.3.18",
    "@mantine/hooks": "^8.3.18",
    "@tanstack/react-table": "^8.21.3",
    "@tauri-apps/api": "2.11.0",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-sql": "^2.4.0",
    "cmdk": "^1.1.1",
    "d3": "^7.9.0",
    "lucide-react": "^1.16.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@playwright/test": "^1.60.0",
    "@tauri-apps/cli": "2.11.2",
    "@types/node": "^24.12.2",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "postcss": "^8.5.10",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
